[Unit]
Description=Gabbee Plasma Backend
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
Environment=GABBEE_ENV_FILE=%h/.opencasenv/.env
ExecStart=%h/gabbee/.venv/bin/python -m gabbee.plasma_dbus_service
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
